FROM ghcr.io/krism-eu/rakuos-base:minimal-base AS minimal

FROM ghcr.io/rakuos/rakuos-base:latest AS rakuos-runtime

FROM minimal

COPY --from=rakuos-runtime /usr/bin/rakuos /usr/bin/rakuos
COPY --from=rakuos-runtime /usr/libexec/rakuos /usr/libexec/rakuos
COPY --from=rakuos-runtime /usr/lib/systemd/system/rakuos-*.service /usr/lib/systemd/system/
COPY --from=rakuos-runtime /usr/lib/systemd/user/rakuos-user.service /usr/lib/systemd/user/
COPY --from=rakuos-runtime /usr/lib/tmpfiles.d/rakuos-*.conf /usr/lib/tmpfiles.d/
COPY --from=rakuos-runtime /usr/share/rakuos /usr/share/rakuos

RUN dnf5 -y \
    --setopt=install_weak_deps=false \
    --setopt=clean_requirements_on_remove=true \
    install \
    plasma-desktop \
    plasma-workspace \
    plasma-login-manager \
    kcm-plasmalogin \
    kde-settings \
    kde-settings-plasma \
    kde-settings-plasmalogin \
    kscreen \
    powerdevil \
    plasma-nm \
    plasma-pa \
    plasma-systemmonitor \
    kde-gtk-config \
    bluedevil \
    kwalletmanager5 \
    kio-fuse \
    xdg-desktop-portal-kde \
    xorg-x11-server-Xwayland \
    dolphin \
    dolphin-plugins \
    konsole \
    ark \
    gwenview \
    spectacle \
    kinfocenter \
    kdeplasma-addons \
    okular \
    kfind \
    filelight \
    kio-admin \
    kate \
    kwrite \
    kf6-sonnet-hunspell \
    fastfetch \
    hunspell-it \
    unrar-free \
    system-config-printer \
    f44-backgrounds-base \
    f44-backgrounds-kde \
    && dnf5 clean all \
    && rm -rf \
        /var/cache/dnf \
        /var/cache/libdnf5 \
        /var/log/dnf5.log \
        /run/dnf \
        /run/mdadm

RUN test -x /usr/bin/rakuos
RUN test -x /usr/libexec/rakuos/rakuos-install
RUN test -x /usr/libexec/rakuos/rakuos-overlay-sync
RUN test -x /usr/libexec/rakuos/generate-base-manifest

RUN systemctl set-default graphical.target
RUN systemctl enable plasmalogin.service

RUN bootc container lint

LABEL org.opencontainers.image.title="RakuOS KDE Plasma"
LABEL org.opencontainers.image.description="RakuOS KDE Plasma image"
LABEL org.opencontainers.image.source="https://github.com/krism-eu/rakuos-base"

CMD ["/sbin/init"]
